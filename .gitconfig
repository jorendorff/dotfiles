[user]
	name = Jason Orendorff
	email = jorendorff@github.com

[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
	glog = log --graph --all --decorate
[push]
	default = simple
[pull]
	ff = only

[diff]
        algorithm = patience
        submodule = log

[merge]
        conflictstyle = diff3
[color]
	ui = auto
[github]
	user = jorendorff
[advice]
	detachedHead = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	branch = main
	defaultBranch = main

# Rewrite all HTTPS repo URLs to use SSH instead. But see the exceptions below.
[url "git@github.com:"]
	insteadOf = https://github.com/
# The extra rules below are exceptions to the above rule for tools that can't handle it.
# Carveout for `cargo edit`
[url "https://github.com/rust-lang/crates.io-index"]
  insteadOf = https://github.com/rust-lang/crates.io-index
# Carveout for `cargo audit`
[url "https://github.com/RustSec/advisory-db"]
  insteadOf = https://github.com/RustSec/advisory-db
